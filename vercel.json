{
  "buildCommand": "npm run build && cd docs && npm ci --include=dev && npm run build && cd .. && node -e \"require('fs').cpSync('docs/build','dist/docs',{recursive:true})\"",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/img/a/:match*", "destination": "https://xahaxtbudiubelemewna.supabase.co/storage/v1/object/public/adverts/:match*" },
    { "source": "/img/:bucket/:match*", "destination": "https://xahaxtbudiubelemewna.supabase.co/storage/v1/object/public/:bucket/:match*" },
    { "source": "/supabase-storage/:match*", "destination": "https://xahaxtbudiubelemewna.supabase.co/storage/v1/object/public/:match*" },
    { "source": "/payments/confirm", "destination": "https://xahaxtbudiubelemewna.supabase.co/functions/v1/mpesa-stk-push/callback" },
    { "source": "/api/unsubscribe", "destination": "https://xahaxtbudiubelemewna.supabase.co/functions/v1/unsubscribe" },
    { "source": "/supabase/:match*", "destination": "https://xahaxtbudiubelemewna.supabase.co/:match*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/img/(.*)", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
    ]},
    { "source": "/supabase-storage/(.*)", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
    ]}
  ]
}
